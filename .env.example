# Export in your shell. This file is a reference and is not auto-loaded.
# OpenAI-compatible gateway and its exact DeepSeek model ID.
DBA_AGENT_BASE_URL=https://api.gapgpt.app/v1
DBA_AGENT_MODEL=gapgpt-deepseek-v4.1-flash
# Set the key privately in your environment. Never put credentials in this file.
DBA_AGENT_API_KEY=
DBA_AGENT_STATE_DIR=.dba_agent/sessions
DBA_AGENT_OUTPUT_DIR=output
DBA_AGENT_TIMEOUT=60
DBA_AGENT_LLM_ATTEMPTS=2
DBA_AGENT_MAX_INTERVIEW_ROUNDS=6
DBA_AGENT_MAX_SQL_ATTEMPTS=3
# Optional override for the native SQL validation container. The image must be local.
DBA_AGENT_SQL_VALIDATION_IMAGE=
DBA_AGENT_CACHE_ENABLED=1
